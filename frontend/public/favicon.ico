<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <defs>
    <linearGradient id="beerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B" />
      <stop offset="100%" stop-color="#D97706" />
    </linearGradient>
    <linearGradient id="foamGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="100%" stop-color="#FEF3C7" />
    </linearGradient>
  </defs>
  <!-- Mug Body -->
  <rect x="14" y="20" width="28" height="34" rx="4" fill="url(#beerGrad)" stroke="#B45309" stroke-width="2" />
  <!-- Handle -->
  <path d="M42 26 H48 C52 26 55 29 55 33 V41 C55 45 52 48 48 48 H42" fill="none" stroke="#F59E0B" stroke-width="4" stroke-linecap="round" />
  <!-- Beer Foam -->
  <path d="M12 20 C12 16 16 14 20 16 C23 13 29 13 32 15 C35 13 41 14 43 17 C46 17 48 20 46 22 H14 C12 22 12 21 12 20 Z" fill="url(#foamGrad)" />
  <!-- Delivery Speed Lines -->
  <path d="M4 28 H9 M2 34 H7 M4 40 H10" stroke="#F59E0B" stroke-width="2.5" stroke-linecap="round" />
  <!-- Sparkles -->
  <circle cx="22" cy="30" r="1.5" fill="#FEF3C7" opacity="0.8" />
  <circle cx="28" cy="38" r="2" fill="#FEF3C7" opacity="0.8" />
  <circle cx="34" cy="28" r="1.5" fill="#FEF3C7" opacity="0.8" />
</svg>
