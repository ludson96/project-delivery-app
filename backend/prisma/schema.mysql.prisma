generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(255)
  email    String  @unique @db.VarChar(255)
  password String  @db.VarChar(255)
  role     String  @default("customer") @db.VarChar(50)

  orders       Sale[] @relation("CustomerSales")
  sellerOrders Sale[] @relation("SellerSales")

  @@map("users")
}

model Product {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(255)
  price    Decimal @db.Decimal(9, 2)
  urlImage String  @map("url_image") @db.VarChar(255)

  sales SalesProduct[]

  @@map("products")
}

model Sale {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  sellerId        Int      @map("seller_id")
  totalPrice      Decimal  @map("total_price") @db.Decimal(9, 2)
  deliveryAddress String   @map("delivery_address") @db.VarChar(255)
  deliveryNumber  String   @map("delivery_number") @db.VarChar(50)
  saleDate        DateTime @default(now()) @map("sale_date")
  status          String   @default("Pendente") @db.VarChar(50)

  user     User           @relation("CustomerSales", fields: [userId], references: [id], onDelete: Cascade)
  seller   User           @relation("SellerSales", fields: [sellerId], references: [id], onDelete: Cascade)
  products SalesProduct[]

  @@map("sales")
}

model SalesProduct {
  saleId    Int @map("sale_id")
  productId Int @map("product_id")
  quantity  Int

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([saleId, productId])
  @@map("sales_products")
}
